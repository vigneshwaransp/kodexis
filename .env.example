# ==============================================================================
# KODEXIS Environment Variables & Configuration Template
# Copy this file to .env or .env.local to configure your local or production deployment.
# ==============================================================================

# --- AI API Configuration (Mistral AI / NVIDIA NIM) ---
# If no API key is provided, KODEXIS automatically activates its intelligent
# deterministic offline mode with zero errors for seamless demos and local testing.
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=open-mistral-7b

# --- Frontend Client-Side Environment (Vite) ---
# Points to the Spring Boot REST backend or mock server
VITE_API_URL=http://localhost:8080
VITE_MISTRAL_API_KEY=your_mistral_api_key_here
VITE_MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
VITE_MISTRAL_MODEL=open-mistral-7b

# --- Backend Server Configuration (Spring Boot) ---
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- Security & JWT (Spring Boot) ---
# 64+ character cryptographic secret for signing JSON Web Tokens
JWT_SECRET=your_64_char_cryptographic_secret_here_replace_before_deploying

# --- Database Configuration (Default: Embedded Persistent H2 with PostgreSQL syntax) ---
# To connect to external production PostgreSQL (e.g., Render Postgres / AWS RDS), uncomment below:
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/kodexisdb
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_db_password
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
# SPRING_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
